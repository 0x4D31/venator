<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.detect.venator.example</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/REPLACE_ME/.local/libexec/venator-run-example</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>5</integer>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <!-- Decimal 63 is octal 077: launchd creates stdout/stderr as owner-only. -->
  <key>Umask</key>
  <integer>63</integer>

  <key>StandardOutPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/Venator/example.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/Venator/example.stderr.log</string>
</dict>
</plist>
