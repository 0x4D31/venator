{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "secretEnv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "secretName": {"type": "string"},
        "key": {"type": "string", "minLength": 1},
        "optional": {"type": "boolean"}
      }
    }
  },
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 0},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image", "imagePullPolicy"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "image": {"type": "string", "minLength": 1},
        "imagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {"name": {"type": "string", "minLength": 1}}
      }
    },
    "cronJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeZone", "concurrencyPolicy", "startingDeadlineSeconds",
        "activeDeadlineSeconds", "backoffLimit",
        "successfulJobsHistoryLimit", "failedJobsHistoryLimit"
      ],
      "properties": {
        "timeZone": {"type": "string", "minLength": 1},
        "concurrencyPolicy": {"enum": ["Allow", "Forbid", "Replace"]},
        "startingDeadlineSeconds": {"type": "integer", "minimum": 0},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "ttlSecondsAfterFinished": {"type": ["integer", "null"], "minimum": 0},
        "successfulJobsHistoryLimit": {"type": "integer", "minimum": 0},
        "failedJobsHistoryLimit": {"type": "integer", "minimum": 0}
      }
    },
    "resources": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "containerSecurityContext": {"type": "object"},
    "secretEnv": {
      "type": "array",
      "items": {"$ref": "#/definitions/secretEnv"}
    },
    "ruleSecretEnv": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"$ref": "#/definitions/secretEnv"}
      }
    },
    "envFrom": {"type": "array"},
    "ruleEnvFrom": {"type": "object"},
    "extraEnv": {"type": "array"},
    "extraVolumes": {"type": "array"},
    "extraVolumeMounts": {"type": "array"},
    "ruleExtraVolumes": {"type": "object"},
    "ruleExtraVolumeMounts": {"type": "object"},
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object"},
        "automountServiceAccountToken": {"type": "boolean"}
      }
    },
    "ruleServiceAccounts": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "required": ["container", "cronJob"]
}
