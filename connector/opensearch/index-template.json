{
  "index_patterns": ["venator-findings-v1*"],
  "priority": 200,
  "template": {
    "mappings": {
      "dynamic": false,
      "properties": {
        "schema_version": {"type": "keyword"},
        "id": {"type": "keyword"},
        "run_id": {"type": "keyword"},
        "detected_at": {"type": "date_nanos"},
        "event_at": {"type": "date_nanos"},
        "source": {"type": "keyword", "ignore_above": 1024},
        "output_format": {"type": "keyword"},
        "rule": {
          "properties": {
            "id": {"type": "keyword", "ignore_above": 1024},
            "name": {"type": "keyword", "ignore_above": 1024},
            "status": {"type": "keyword", "ignore_above": 1024},
            "confidence": {"type": "keyword"},
            "tags": {"type": "keyword", "ignore_above": 1024},
            "ttp_ids": {"type": "keyword", "ignore_above": 1024}
          }
        },
        "attributes": {
          "properties": {
            "actor_user_name": {"type": "keyword", "ignore_above": 1024},
            "actor_user_uid": {"type": "keyword", "ignore_above": 1024},
            "resource_name": {"type": "keyword", "ignore_above": 1024},
            "resource_type": {"type": "keyword", "ignore_above": 1024},
            "resource_uid": {"type": "keyword", "ignore_above": 1024},
            "src_hostname": {"type": "keyword", "ignore_above": 1024},
            "src_ip": {"type": "ip", "ignore_malformed": true},
            "dst_hostname": {"type": "keyword", "ignore_above": 1024},
            "dst_ip": {"type": "ip", "ignore_malformed": true},
            "message": {"type": "text"},
            "event_id": {"type": "keyword", "ignore_above": 1024},
            "event_index": {"type": "keyword", "ignore_above": 1024}
          }
        },
        "payload": {"type": "object", "enabled": false},
        "review": {
          "properties": {
            "verdict": {"type": "keyword"},
            "reason": {"type": "text"},
            "reviewer": {"type": "keyword", "ignore_above": 1024},
            "reviewed_at": {"type": "date_nanos"}
          }
        }
      }
    }
  },
  "_meta": {
    "description": "Venator v0.2.0 canonical finding envelope"
  }
}
